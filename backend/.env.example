# Local development template. Copy to `.env` for `npm run dev` in backend/.
# On Coolify these are set as environment variables on the API application —
# no .env file is shipped in the image.

MONGO_URI=mongodb://127.0.0.1:27017/TrackED
PORT=5000
JWT_EXPIRES_IN=30d

# Must be a long random string, e.g. `openssl rand -hex 32`. Never reuse the
# placeholder that was previously committed to this repository.
JWT_SECRET=replace-me-with-a-long-random-string

# Face verification: distance threshold for a match (lower = stricter).
# FACE_MATCH_THRESHOLD=0.5

# Optional. When BOTH are set, the API creates the first admin on boot, and
# only if no admin account exists yet. Leave unset for local development and
# run `npm run seed:admin` instead.
# ADMIN_EMAIL=admin@your.school
# ADMIN_PASSWORD=use-a-strong-unique-password
# ADMIN_NAME=System Admin

# Set by the container image; leave unset locally so the port-recovery hook
# in scripts/free-port.js keeps working during development.
# TRACKED_NO_AUTO_FREE=1

# ---------------------------------------------------------------------------
# Email delivery. Set these on the API application's environment in Coolify,
# not the frontend. See docs/EMAIL.md for setup and message source files.
# Gmail requires 2-Step Verification and an App Password; never use the normal
# Google account password. MAIL_FROM must use the authenticated sending address.
# Without SMTP, notices stay in-app and current signups skip verification;
# password recovery by email is unavailable in production. Configure mail
# before relying on verified signup or password recovery.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-sending-address@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM=TrackED <your-sending-address@gmail.com>
# MAIL_REPLY_TO=your-monitored-support-address@example.com
# Production must use the public HTTPS website. Local development may use
# APP_URL=http://localhost:5173
# APP_URL=https://track-ed.vispo.me
