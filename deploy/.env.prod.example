# Copy to deploy/.env.prod and replace every placeholder before deploying.
# deploy/.env.prod is ignored by git and must never be committed.

# Public hostname pointed at the VM. Caddy uses it for automatic HTTPS.
DOMAIN=tracked-example.duckdns.org

# Internal Docker service name: MongoDB is not published to the host.
MONGO_URI=mongodb://mongo:27017/TrackED
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_EXPIRES_IN=30d
PORT=5000
TRACKED_NO_AUTO_FREE=1

# Used only on the first boot, when no admin account exists.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_NAME=System Admin

# Email delivery is managed in the API environment, not an admin profile.
# Use the authenticated sending address in MAIL_FROM. See docs/EMAIL.md.
# Without SMTP, notices remain in-app and current signups skip verification;
# production password recovery by email is unavailable. Configure and test
# mail before relying on verified signup or password recovery.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-sending-address@gmail.com
# SMTP_PASS=your-16-character-app-password
# MAIL_FROM=TrackED <your-sending-address@gmail.com>
# MAIL_REPLY_TO=your-monitored-support-address@example.com
# Use the public HTTPS website; never localhost in production.
APP_URL=https://tracked-example.duckdns.org

# Optional build-time Maps Embed API key. Empty keeps keyless maps.
VITE_GOOGLE_MAPS_EMBED_KEY=
