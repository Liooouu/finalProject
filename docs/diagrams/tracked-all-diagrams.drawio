        <mxCell id="c410" value="EVENT&lt;br&gt;PK  event_id&lt;br&gt;FK  organizer_id → USER&lt;br&gt;title · description&lt;br&gt;date · time · end_date · end_time&lt;br&gt;location · map_query&lt;br&gt;status  (upcoming / live / finished / closed)&lt;br&gt;attendance_start_time · attendance_end_time&lt;br&gt;manual_override · auto_finished_at&lt;br&gt;notification flags&lt;br&gt;created_at · updated_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="390" width="290" height="280" as="geometry"/></mxCell>
        <mxCell id="c411" value="ATTENDANCE&lt;br&gt;PK  attendance_id&lt;br&gt;FK  event_id → EVENT&lt;br&gt;FK  student_id → USER&lt;br&gt;attended_at&lt;br&gt;status  (present / late / absent /&lt;br&gt;pending / excused)&lt;br&gt;community_service_hours&lt;br&gt;event_title · event_date&lt;br&gt;UNIQUE (event_id, student_id)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1090" y="390" width="280" height="250" as="geometry"/></mxCell>
        <mxCell id="c412" value="CS_LOG  (weak)&lt;br&gt;PK  log_id&lt;br&gt;FK  attendance_id&lt;br&gt;action  (penalty /&lt;br&gt;removed / restored)&lt;br&gt;hours · note · at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1430" y="430" width="225" height="190" as="geometry"/></mxCell>
        <mxCell id="c413" value="EXCUSE&lt;br&gt;PK  excuse_id&lt;br&gt;FK  student_id → USER&lt;br&gt;FK  event_id → EVENT&lt;br&gt;FK  reviewed_by → USER&lt;br&gt;excuse_text&lt;br&gt;type  (absence / advance)&lt;br&gt;status  (pending / approved / rejected)&lt;br&gt;response_note&lt;br&gt;removed_hours&lt;br&gt;attachment_url&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="290" height="260" as="geometry"/></mxCell>
        <mxCell id="c414" value="NOTIFICATION&lt;br&gt;PK  notification_id&lt;br&gt;FK  user_id → USER&lt;br&gt;FK  related_event_id → EVENT&lt;br&gt;type · title · message&lt;br&gt;is_read&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1090" y="60" width="270" height="200" as="geometry"/></mxCell>
        <mxCell id="c415" value="FACE_APPEAL&lt;br&gt;PK  appeal_id&lt;br&gt;FK  student_id → USER&lt;br&gt;FK  reviewed_by → USER&lt;br&gt;note · photo_url&lt;br&gt;status · response_note&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="120" y="760" width="260" height="180" as="geometry"/></mxCell>
        <mxCell id="c416" value="PIN_RESET_REQUEST&lt;br&gt;PK  request_id&lt;br&gt;FK  student_id → USER&lt;br&gt;FK  reviewed_by → USER&lt;br&gt;note · status · response_note&lt;br&gt;device_id · device_label&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="420" y="760" width="280" height="190" as="geometry"/></mxCell>
        <mxCell id="c417" value="SETTING&lt;br&gt;PK  key&lt;br&gt;smtp_host · smtp_port · smtp_secure&lt;br&gt;smtp_user · smtp_from · app_url&lt;br&gt;templates  (verification / reset /&lt;br&gt;notification)&lt;br&gt;FK  updated_by → USER&lt;br&gt;updated_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1180" y="760" width="320" height="190" as="geometry"/></mxCell>
        <mxCell id="c418" value="FILE  (optional)&lt;br&gt;PK  file_id&lt;br&gt;url · original_name&lt;br&gt;content_type · size" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="390" y="60" width="200" height="130" as="geometry"/></mxCell>
        <mxCell id="c419" value="registers" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;html=1;" edge="1" parent="1" source="c408" target="c409"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c420" value="creates" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;html=1;" edge="1" parent="1" source="c408" target="c410"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c421" value="has" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;html=1;" edge="1" parent="1" source="c408" target="c411"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c422" value="records" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;html=1;" edge="1" parent="1" source="c410" target="c411"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c423" value="logs" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;html=1;" edge="1" parent="1" source="c411" target="c412"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c424" value="files" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;html=1;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="c408" target="c413"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c425" value="reviews" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;html=1;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c408" target="c413"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c426" value="receives" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;html=1;" edge="1" parent="1" source="c408" target="c414"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c427" value="relates to" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;html=1;" edge="1" parent="1" source="c410" target="c414"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c428" value="submits" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;html=1;" edge="1" parent="1" source="c408" target="c415"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c429" value="requests" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;html=1;" edge="1" parent="1" source="c408" target="c416"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c430" value="updates" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;html=1;" edge="1" parent="1" source="c408" target="c417"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c431" value="attaches" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;html=1;" edge="1" parent="1" source="c413" target="c418"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c432" value="Crow's foot notation.  ATTENDANCE is the associative entity that resolves the student–event many-to-many relationship.  TRUSTED_DEVICE and CS_LOG are weak entities (MongoDB embedded arrays) — double-border them in the final rendering.  FILE is optional: attachments live in GridFS and are referenced by URL." style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="980" width="1300" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dg-c503" name="1.0 Sequence - QR Code Attendance">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1120" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c433" value="alt  rejection paths: not open yet · QR expired · already marked · window closed · not authorised" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#6b7280;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="1380" height="480" as="geometry"/></mxCell>
        <mxCell id="c434" value="Student : Browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="90" y="120" width="150" height="900" as="geometry"/></mxCell>
        <mxCell id="c435" value="Organizer : Browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="320" y="120" width="150" height="900" as="geometry"/></mxCell>
        <mxCell id="c436" value="API : Express" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="150" height="900" as="geometry"/></mxCell>
        <mxCell id="c437" value="Database : MongoDB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="920" y="120" width="150" height="900" as="geometry"/></mxCell>
        <mxCell id="c438" value="Notifier : In-app + SMTP" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1220" y="120" width="150" height="900" as="geometry"/></mxCell>
        <mxCell id="c439" value="1. GET /api/events/:id  (JWT)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.1000;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1000;entryDx=0;entryDy=0;" edge="1" parent="1" source="c434" target="c436"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c440" value="2. find event" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.1511;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1511;entryDx=0;entryDy=0;" edge="1" parent="1" source="c436" target="c437"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c441" value="3. event document" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.2022;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2022;entryDx=0;entryDy=0;" edge="1" parent="1" source="c437" target="c436"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c442" value="4. event + attendance window" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.2533;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2533;entryDx=0;entryDy=0;" edge="1" parent="1" source="c436" target="c434"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c443" value="5. render QR {eventId, studentId, issuedAt};&lt;br&gt;   refresh every 30 s (no server call)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0.3044;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3289;entryDx=0;entryDy=0;" edge="1" parent="1" source="c434" target="c434"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="205" y="394"/><mxPoint x="205" y="416"/></Array></mxGeometry></mxCell>
        <mxCell id="c444" value="6. POST /api/events/:id/attendance/scan&lt;br&gt;   {studentId, timestamp}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.3556;exitDx=0;exitDy=0;entryX=0.5;entryY=0.3556;entryDx=0;entryDy=0;" edge="1" parent="1" source="c435" target="c436"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c445" value="7. find event + find student" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.4067;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4067;entryDx=0;entryDy=0;" edge="1" parent="1" source="c436" target="c437"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c446" value="8. authorise owner/admin-created · not terminal ·&lt;br&gt;   window open · QR age ≤ 10 min" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0.4578;exitDx=0;exitDy=0;entryX=0.5;entryY=0.4822;entryDx=0;entryDy=0;" edge="1" parent="1" source="c436" target="c436"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="735" y="532"/><mxPoint x="735" y="554"/></Array></mxGeometry></mxCell>
        <mxCell id="c447" value="9. find attendance (duplicate check)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.5089;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5089;entryDx=0;entryDy=0;" edge="1" parent="1" source="c436" target="c437"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c448" value="10. decide present / late (+4 CS hours)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0.5600;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5844;entryDx=0;entryDy=0;" edge="1" parent="1" source="c436" target="c436"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="735" y="624"/><mxPoint x="735" y="646"/></Array></mxGeometry></mxCell>
        <mxCell id="c449" value="11. insert / update attendance + CS log" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.6111;exitDx=0;exitDy=0;entryX=0.5;entryY=0.6111;entryDx=0;entryDy=0;" edge="1" parent="1" source="c436" target="c437"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c450" value="12. insert notification" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.6622;exitDx=0;exitDy=0;entryX=0.5;entryY=0.6622;entryDx=0;entryDy=0;" edge="1" parent="1" source="c436" target="c437"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c451" value="13. queue email (async)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.7133;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7133;entryDx=0;entryDy=0;" edge="1" parent="1" source="c436" target="c438"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c452" value="14. 201 { attendance, message }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.7644;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7644;entryDx=0;entryDy=0;" edge="1" parent="1" source="c436" target="c435"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c453" value="15. pause 1.8 s · show feedback · resume camera" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0.8156;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8400;entryDx=0;entryDy=0;" edge="1" parent="1" source="c435" target="c435"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="435" y="854"/><mxPoint x="435" y="876"/></Array></mxGeometry></mxCell>
        <mxCell id="c454" value="Design note: the server clock, not the client timestamp, decides present vs late. The QR timestamp is only a freshness check — a screenshot older than 10 minutes is rejected." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="250" y="1000" width="1000" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dg-c504" name="1.1 Sequence - Excuse Submission and Review">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1320" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c455" value="alt  already reviewed → 409 (atomic claim on status = pending; hours are never deducted twice)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#6b7280;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="740" width="1460" height="90" as="geometry"/></mxCell>
        <mxCell id="c456" value="opt  side effect fails → excuse reverted to pending   ·   reject → no attendance or hour change" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#6b7280;verticalAlign=top;align=left;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="870" width="1460" height="130" as="geometry"/></mxCell>
        <mxCell id="c457" value="Student : Browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="70" y="120" width="150" height="1100" as="geometry"/></mxCell>
        <mxCell id="c458" value="API : Express" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="150" height="1100" as="geometry"/></mxCell>
        <mxCell id="c459" value="FileStore : GridFS" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="590" y="120" width="150" height="1100" as="geometry"/></mxCell>
        <mxCell id="c460" value="Database : MongoDB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="850" y="120" width="150" height="1100" as="geometry"/></mxCell>
        <mxCell id="c461" value="Organizer / Admin : Browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1110" y="120" width="160" height="1100" as="geometry"/></mxCell>
        <mxCell id="c462" value="Notifier : In-app + SMTP" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="1380" y="120" width="150" height="1100" as="geometry"/></mxCell>
        <mxCell id="c463" value="1. POST /api/student/excuses  (multipart + JWT)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.0727;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0727;entryDx=0;entryDy=0;" edge="1" parent="1" source="c457" target="c458"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c464" value="2. verify role · event exists · no active excuse ·&lt;br&gt;   absence needs an absent record, advance needs an upcoming event" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0.1127;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1327;entryDx=0;entryDy=0;" edge="1" parent="1" source="c458" target="c458"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="445" y="244"/><mxPoint x="445" y="266"/></Array></mxGeometry></mxCell>
        <mxCell id="c465" value="3. save up to 5 images (JPEG/PNG, ≤ 4 MB)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.1527;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1527;entryDx=0;entryDy=0;" edge="1" parent="1" source="c458" target="c459"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c466" value="4. stored URLs" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.1927;exitDx=0;exitDy=0;entryX=0.5;entryY=0.1927;entryDx=0;entryDy=0;" edge="1" parent="1" source="c459" target="c458"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c467" value="5. insert Excuse { status: pending }" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.2327;exitDx=0;exitDy=0;entryX=0.5;entryY=0.2327;entryDx=0;entryDy=0;" edge="1" parent="1" source="c458" target="c460"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
