        <mxCell id="c483" value="19. 200 reviewed excuse" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontSize=10;exitX=0.5;exitY=0.8582;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8582;entryDx=0;entryDy=0;" edge="1" parent="1" source="c458" target="c461"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c484" value="Advance excuses are approved before the event, so the attendance record is created as “excused” and the 60-second absence job never penalises the student. Approving a later check-in restores the hours the excuse removed." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="180" y="1090" width="1200" height="90" as="geometry"/></mxCell>
